{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "turbo run build --filter=web-app --ui stream --log-order grouped",
  "outputDirectory": "apps/web-app/.next",
  "crons": [
    {
      "path": "/api/vault/invest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/pool-rates/record",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/asset-prices/record",
      "schedule": "0 2 * * *"
    }
  ]
}
