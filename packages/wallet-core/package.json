{
  "name": "@neko-protocol/wallet-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "require": "./dist/mock.js",
      "default": "./dist/mock.js"
    }
  },
  "typesVersions": {
    "*": {
      "mock": [
        "./dist/mock.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neko-Protocol/neko-mainnet.git",
    "directory": "packages/wallet-core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^14.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
