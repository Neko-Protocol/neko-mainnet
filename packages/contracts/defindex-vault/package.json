{
  "version": "0.1.0",
  "name": "@neko-protocol/defindex-vault",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neko-Protocol/neko-mainnet.git",
    "directory": "packages/contracts/defindex-vault"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --external:@stellar/stellar-sdk --external:buffer --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.2"
  }
}
