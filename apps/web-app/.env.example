# Stellar Network Configuration
NEXT_PUBLIC_STELLAR_NETWORK=MAINNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015" 
# Routed through the backend gateway, which owns the endpoint pool and the
# provider API keys. A path here keeps credentials off the client entirely.
# Set an absolute provider URL instead to bypass the gateway — that is the
# rollback, and it is a config change rather than a deploy.
NEXT_PUBLIC_STELLAR_RPC_URL=/api/rpc
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org

# xBull Swap referral fees are charged in the output asset. Use a Stellar
# account or contract address able to receive every output asset we support.
SWAP_REFERRAL_ADDRESS=

# Etherfuse FX
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# Alfred Pay
ALFREDPAY_API_KEY=
ALFREDPAY_API_SECRET=
ALFREDPAY_BASE_URL=https://api-service-co.alfredpay.app/api/v1/third-party-service/penny
ALFREDPAY_WEBHOOK_SECRET=

# DeFindex HTTP API key
DEFINDEX_API_KEY=

# Supabase - audit logs + users
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App origin used for Supabase magic-link redirects.
# Production should match Supabase Auth > URL Configuration > Site URL.
NEXT_PUBLIC_APP_URL=https://dapp.nekoprotocol.xyz

# Neko backend (transaction relay). Server-only.
# BACKEND_INTERNAL_KEY must match Railway INTERNAL_API_KEY.
BACKEND_INTERNAL_URL=http://localhost:4000
BACKEND_INTERNAL_KEY=

# Use backend dashboard
NEXT_PUBLIC_USE_BACKEND_DASHBOARD=false
