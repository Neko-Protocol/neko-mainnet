# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend proxy (same shared secret as apps/backend's INTERNAL_API_KEY)
BACKEND_INTERNAL_URL=
BACKEND_INTERNAL_KEY=

# Public dApp origin (apps/web-app), used to build shareable referral links
# (e.g. https://app.nekoprotocol.xyz/?ref=CODE) on the Referrals page.
NEXT_PUBLIC_WEB_APP_URL=

# Grafana Cloud metrics query API, powers the history charts on the
# Infrastructure page. Without these the live counters still work and the
# charts explain what is missing.
#
# URL and user come from the Cloud Portal: your stack, the Prometheus card,
# Details. The user is the metrics instance id. The token is an access policy
# token scoped metrics:read (Security -> Access Policies).
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_PROM_TOKEN=
